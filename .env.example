# Google Apps Script web-app URL that receives form submissions.
# Deploy > New deployment > Web app  (Execute as: Me / Who has access: Anyone)
# Copy the URL ending in /exec.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Optional. Must match CONFIG.SHARED_SECRET in google-apps-script/Code.gs.
# Leave unset if you left SHARED_SECRET empty in the script.
GOOGLE_SCRIPT_SECRET=
